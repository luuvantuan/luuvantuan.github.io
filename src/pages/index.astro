---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import TopicList from "../components/TopicList.astro";
import { SITE, SHOW } from "../site";
import { getPosts } from "../utils";

const all = await getPosts();
const posts = all.slice(0, 8);
---
<Base>
  <section class="intro">
    {/* Tiêu đề ẩn: không hiện trên trang nhưng Google và trình đọc màn hình vẫn đọc được */}
    <h1 class="sr-only">{SITE.title}</h1>
    <p>
      {SITE.description} I also make videos on{" "}
      <a href={SITE.youtube} target="_blank" rel="noopener">YouTube</a>.
    </p>
  </section>

  {posts.length > 0 && (
    <>
      <h2 class="section-title">Latest posts</h2>
      <PostList posts={posts} />
      <p class="meta more"><a href="/blog/">All posts →</a></p>
    </>
  )}

  {SHOW.topics && (
    <>
      <h2 class="section-title">What I write about</h2>
      <TopicList posts={all} />
    </>
  )}
</Base>

---
import Base from "../layouts/Base.astro";
import PostList from "../components/PostList.astro";
import TopicList from "../components/TopicList.astro";
import { SITE } from "../site";
import { getPosts } from "../utils";

const all = await getPosts();
const posts = all.slice(0, 8);
---
<Base>
  <section class="intro">
    <h1>Xin chào, mình là Tuấn.</h1>
    <p>
      {SITE.description} Thỉnh thoảng mình cũng làm video trên{" "}
      <a href={SITE.youtube} target="_blank" rel="noopener">YouTube</a>.
    </p>
  </section>

  {posts.length > 0 && (
    <>
      <h2 class="section-title">Bài viết mới</h2>
      <PostList posts={posts} />
      <p class="meta more"><a href="/blog/">Xem tất cả bài viết →</a></p>
    </>
  )}

  <h2 class="section-title">Mình đang viết về</h2>
  <TopicList posts={all} />
</Base>

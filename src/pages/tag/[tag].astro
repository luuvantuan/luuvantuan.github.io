---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts, slugify, type Post } from "../../utils";

export async function getStaticPaths() {
  const posts = await getPosts();
  const names = [...new Set(posts.flatMap((p) => p.data.tags))];
  return names.map((name) => ({
    params: { tag: slugify(name) },
    props: { name, posts: posts.filter((p) => p.data.tags.includes(name)) },
  }));
}

interface Props { name: string; posts: Post[] }
const { name, posts } = Astro.props;
---
<Base title={`Chủ đề: ${name}`} description={`Các bài viết về ${name}.`}>
  <section class="intro">
    <p class="meta"><a href="/tag/">Chủ đề</a> /</p>
    <h1>{name}</h1>
    <p>{posts.length} bài viết</p>
  </section>
  <h2 class="section-title">Danh sách</h2>
  <PostList posts={posts} />
</Base>

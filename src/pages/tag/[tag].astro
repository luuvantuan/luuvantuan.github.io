---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { TOPICS } from "../../site";
import { getPosts, slugify, type Post } from "../../utils";

export async function getStaticPaths() {
  const posts = await getPosts();
  return TOPICS.map((t) => ({
    params: { tag: slugify(t.name) },
    props: {
      name: t.name,
      description: t.description,
      posts: posts.filter((p) => (p.data.tags as string[]).includes(t.name)),
    },
  }));
}

interface Props { name: string; description: string; posts: Post[] }
const { name, description, posts } = Astro.props;
---
<Base title={name} description={description}>
  <section class="intro">
    <p class="meta"><a href="/tag/">Chủ đề</a> /</p>
    <h1>{name}</h1>
    <p>{description}</p>
  </section>
  <h2 class="section-title">{posts.length > 0 ? `${posts.length} bài viết` : "Bài viết"}</h2>
  {posts.length > 0 ? <PostList posts={posts} /> : <p class="empty">Chưa có bài nào trong chủ đề này. Sắp có.</p>}
</Base>

---
import Base from "../../layouts/Base.astro";
import TopicList from "../../components/TopicList.astro";
import { TOPICS } from "../../site";
import { getPosts } from "../../utils";

const posts = await getPosts();
---
<Base title="Chủ đề" description="Những chủ đề mình đang theo đuổi và viết về.">
  <section class="intro">
    <h1>Chủ đề</h1>
    <p>{TOPICS.length} điều mình đang theo đuổi và ghi chép lại.</p>
  </section>
  <h2 class="section-title">Tất cả chủ đề</h2>
  <TopicList posts={posts} />
</Base>

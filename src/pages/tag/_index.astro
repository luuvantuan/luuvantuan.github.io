---
import Base from "../../layouts/Base.astro";
import TopicList from "../../components/TopicList.astro";
import { TOPICS } from "../../site";
import { getPosts } from "../../utils";

const posts = await getPosts();
---
<Base title="Topics" description="The things I am pursuing and writing about.">
  <section class="intro">
    <h1>Topics</h1>
    <p>{TOPICS.length} things I am pursuing and writing about.</p>
  </section>
  <h2 class="section-title">All topics</h2>
  <TopicList posts={posts} />
</Base>

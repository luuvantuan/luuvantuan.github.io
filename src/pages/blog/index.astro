---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { TOPICS } from "../../site";
import { getPosts, slugify } from "../../utils";

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
---
<Base title="Bài viết" description="Tất cả bài viết trên blog.">
  <section class="intro">
    <h1>Bài viết</h1>
    <p>{posts.length > 0 ? `${posts.length} bài, mới nhất ở trên.` : "Những bài đầu tiên đang được viết."}</p>
  </section>

  <h2 class="section-title">Chủ đề</h2>
  <ul class="tags">
    {TOPICS.map((t) => <li><a href={`/tag/${slugify(t.name)}/`}>{t.name}</a></li>)}
  </ul>

  {years.map((year) => (
    <>
      <h2 class="year">{year}</h2>
      <PostList posts={posts.filter((p) => p.data.date.getFullYear() === year)} />
    </>
  ))}
</Base>

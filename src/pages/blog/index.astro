---
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { TOPICS, SHOW } from "../../site";
import { getPosts, slugify } from "../../utils";

const posts = await getPosts();
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
---
<Base title="Blog" description="All posts on the blog.">
  <section class="intro">
    <h1>Blog</h1>
    <p>{posts.length > 0 ? `${posts.length} ${posts.length === 1 ? "post" : "posts"}, newest first.` : "The first posts are on their way."}</p>
  </section>

  {SHOW.topics && (
    <>
      <h2 class="section-title">Topics</h2>
      <ul class="tags">
        {TOPICS.map((t) => <li><a href={`/tag/${slugify(t.name)}/`}>{t.name}</a></li>)}
      </ul>
    </>
  )}

  {years.map((year) => (
    <>
      <h2 class="year">{year}</h2>
      <PostList posts={posts.filter((p) => p.data.date.getFullYear() === year)} />
    </>
  ))}
</Base>
